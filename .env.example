# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_MAPS_API_KEY: Server-side Google Maps Platform API key for Air Quality & Geocoding REST APIs.
GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: Optional browser key for interactive Google Maps JS SDK (@vis.gl/react-google-maps).
# Restrict by HTTP referrer and Maps JavaScript API in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY="MY_VITE_GOOGLE_MAPS_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
